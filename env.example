# Supabase Postgres. Use the transaction pooler (port 6543) for the running app.
# URL-encode special characters in the password (@ = %40, # = %23, $ = %24).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# https://console.groq.com
GROQ_API_KEY=

# https://console.cloud.google.com (APIs & Services > Credentials > OAuth client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=3000
NODE_ENV=development

# Public URL of the site. Local: http://localhost:3000. Production: your Vercel/custom domain.
APP_URL=http://localhost:3000
